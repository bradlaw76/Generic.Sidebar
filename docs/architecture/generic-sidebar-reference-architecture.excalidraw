    {
      "type": "text",
      "id": "legend",
      "x": 70,
      "y": 945,
      "width": 1640,
      "height": 85,
      "text": "FLOW: user opens record -> form launches pane -> runtime reads Dataverse -> policy selects route -> configured experience renders\nREUSE: keep the launcher and runtime stable; add or change experiences through configuration rows and narrowly scoped adapters\nSECURITY BOUNDARY: validate configured URLs/HTML, grant least-privilege iframe capabilities, and fail closed when an enabled identity route fails",
      "fontSize": 15,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
